@startuml
!theme mars

title "Model 01: Venus Sequence Diagram"

actor Researcher
participant "CLI-Based System" as CLISystem
participant "Configuration Controller" as ConfigController
participant AgentBuilder
participant SimulationEngine
participant Mediator
participant Logger

participant "Agent A" as AgentA
participant "Rule Engine A" as RuleEngineA
participant "Agent B" as AgentB
participant "Rule Engine B" as RuleEngineB
participant "Agent C" as AgentC
participant "Rule Engine C" as RuleEngineC

== System Initialization ==

Researcher -> CLISystem : enter configurations
CLISystem -> ConfigController : initializeSystem()

== Configuration Phase ==

activate ConfigController

ConfigController -> AgentBuilder : buildAgents()
activate AgentBuilder

create AgentA
AgentBuilder -> AgentA : createAgent()
create RuleEngineA
AgentBuilder -> RuleEngineA : assignRuleEngine()

create AgentB
AgentBuilder -> AgentB : createAgent()
create RuleEngineB
AgentBuilder -> RuleEngineB : assignRuleEngine()

create AgentC
AgentBuilder -> AgentC : createAgent()
create RuleEngineC
AgentBuilder -> RuleEngineC : assignRuleEngine()

AgentBuilder --> ConfigController : agentsReady()
deactivate AgentBuilder

ConfigController -> SimulationEngine : setParameters()
ConfigController --> CLISystem : configurationReady()

deactivate ConfigController

== Start Simulation ==

CLISystem -> SimulationEngine : startSimulation()
activate SimulationEngine

loop Until matching is complete

    SimulationEngine -> SimulationEngine : selectNextAgent()
    SimulationEngine -> Mediator : activateAgent(AgentA)
    activate Mediator

    == Action Request ==

    Mediator -> AgentA : requestAction()
    activate AgentA

    AgentA -> RuleEngineA : decideNextAction(knownCandidates)
    activate RuleEngineA
    RuleEngineA --> AgentA : propose(target) / requestIntroduction / noAction
    deactivate RuleEngineA

    alt noAction
        AgentA --> Mediator : noAction
        deactivate AgentA

        Mediator -> Logger : logEvent(noAction)
        activate Logger
        Logger --> Mediator : logged
        deactivate Logger

    else requestIntroduction
        AgentA --> Mediator : requestIntroduction
        deactivate AgentA

        Mediator -> SimulationEngine : introductionRequested(AgentA)

        SimulationEngine -> SimulationEngine : selectUnknownAgent(AgentA)
        SimulationEngine --> Mediator : selectedAgent(AgentB)

        Mediator -> AgentA : introduce(AgentB)
        Mediator -> AgentB : introduce(AgentA)

        Mediator -> SimulationEngine : relationshipUpdated(AgentA, AgentB, JUST_MET)

        Mediator -> Logger : logEvent(introduction)
        activate Logger
        Logger --> Mediator : logged
        deactivate Logger

    else propose to AgentB
        AgentA --> Mediator : proposal(AgentB)
        deactivate AgentA

        Mediator -> AgentB : deliverProposal(from AgentA)
        activate AgentB

        AgentB -> RuleEngineB : evaluateIncomingProposal()
        activate RuleEngineB
        RuleEngineB --> AgentB : accept / reject / switch
        deactivate RuleEngineB

        alt Accept
            AgentB --> Mediator : accept
            deactivate AgentB

            Mediator -> SimulationEngine : matchCreated(AgentA, AgentB)

        else Reject
            AgentB --> Mediator : reject
            deactivate AgentB

            Mediator -> SimulationEngine : proposalRejected(AgentA, AgentB)

        else Switch
            AgentB --> Mediator : switch
            deactivate AgentB

            Mediator -> AgentC : notifyUnmatched()
            activate AgentC
            AgentC --> Mediator : acknowledged
            deactivate AgentC

            Mediator -> SimulationEngine : matchBroken(AgentB, AgentC)
            Mediator -> SimulationEngine : matchCreated(AgentA, AgentB)
        end

        Mediator -> Logger : logEvent(proposal)
        activate Logger
        Logger --> Mediator : logged
        deactivate Logger
    end

    deactivate Mediator

    SimulationEngine -> Logger : logCycleSummary()
    activate Logger
    Logger --> SimulationEngine : logged
    deactivate Logger

    SimulationEngine -> SimulationEngine : checkCompletion()

end

== Output ==

SimulationEngine --> CLISystem : resultsReady()
deactivate SimulationEngine

CLISystem -> Researcher : showOutput()
@enduml